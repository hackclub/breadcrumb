{
  "name": "breadcrumb",
  "version": "0.2.11",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "lint": "oxlint web/app web/lib web/tests web/scripts desktop/src desktop/vite.config.ts desktop/tests playwright.config.ts desktop/unit scripts/desktop-sync-e2e.ts scripts/dashboard-e2e.ts scripts/profiles-e2e.ts scripts/desktop-update-manifest.ts scripts/integrations-e2e.ts scripts/agent-usage-e2e.ts scripts/agent-usage-portal-e2e.ts scripts/update-model-prices.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:web": "bun run --cwd web test",
    "build:web": "bun run --cwd web build",
    "build:desktop": "bun run --cwd desktop build",
    "test:desktop": "bun run --cwd desktop test",
    "test:sync": "bun scripts/desktop-sync-e2e.ts",
    "test:dashboard": "bun scripts/dashboard-e2e.ts",
    "test:profiles": "bun scripts/profiles-e2e.ts",
    "release:manifest": "bun scripts/desktop-update-manifest.ts",
    "test:integrations:web": "bun scripts/integrations-e2e.ts",
    "test:agents": "bun scripts/agent-usage-e2e.ts && bun scripts/agent-usage-portal-e2e.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0"
  },
  "packageManager": "bun@1.4.4"
}
