PUBLIC_URL=http://localhost:3000
# Any PostgreSQL host; auth tables use the breadcrumb_auth schema.
DATABASE_URL=postgres://user:password@localhost:5432/breadcrumb
BETTER_AUTH_SECRET=
# Optional invite list. Leave empty to allow any verified email address.
ALLOWED_EMAILS=friend@example.com
R2_BUCKET=rewindstore
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LOOPS_API_KEY=
LOOPS_TRANSACTIONAL_ID=
REVIEW_AGENT_TOKENS={"reviewer":"REPLACE_WITH_RANDOM_SECRET"}
CRON_SECRET=
ENABLE_AI_REVIEWS=false
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional public HTTPS desktop-update manifest; defaults to the repository preview release.
DESKTOP_UPDATE_MANIFEST_URL=

# Analytics: r2 (default), postgres, or clickhouse. Auth/profiles still use DATABASE_URL.
ANALYTICS_BACKEND=r2
# Optional separate PostgreSQL database for analytics; defaults to DATABASE_URL.
ANALYTICS_DATABASE_URL=
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=breadcrumb
# Change when switching destinations or replaying an earlier backend.
ANALYTICS_INDEX_VERSION=1

# Additional browser origins allowed to call MCP (comma-separated HTTPS origins).
# Native clients without an Origin header need no extra configuration.
MCP_ALLOWED_ORIGINS=
