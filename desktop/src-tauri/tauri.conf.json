{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breadcrumb",
  "version": "0.2.8",
  "identifier": "app.rewind.local",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Breadcrumb",
        "width": 360,
        "height": 400,
        "minWidth": 340,
        "minHeight": 360,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; worker-src 'self' blob:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/breadcrumb-engine", "binaries/breadcrumb-capture"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpipewire-0.3-0",
          "libxcb1",
          "libxss1",
          "libdbus-1-3",
          "libgbm1",
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-pipewire",
          "xdg-desktop-portal",
          "libayatana-appindicator3-1",
          "libxcb-randr0",
          "libxcb-xfixes0",
          "libwayland-client0",
          "libxkbcommon0",
          "libtesseract5"
        ],
        "recommends": ["at-spi2-core"],
        "files": {
          "/usr/share/applications/app.rewind.local.desktop": "../resources/linux/app.rewind.local.desktop"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "pipewire-libs",
          "libxcb",
          "libXScrnSaver",
          "dbus-libs",
          "mesa-libgbm",
          "gstreamer1",
          "gstreamer1-plugins-base",
          "pipewire-gstreamer",
          "xdg-desktop-portal",
          "tesseract-libs"
        ],
        "recommends": ["at-spi2-core"],
        "files": {
          "/usr/share/applications/app.rewind.local.desktop": "../resources/linux/app.rewind.local.desktop"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "usr/share/applications/app.rewind.local.desktop": "../resources/linux/app.rewind.local.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MzQ3M0Y5NEMyRDdFODcKUldTSGZpMU0rWE0wQ0xNLzlabFJkVm5nOHFtQ2tYeEU4MUZQWmwzeXhjMFBmR1NtQzRLSVBsVE4K",
      "endpoints": [
        "https://breadcrumb.hackclub.com/api/desktop/updates/{{target}}/{{arch}}",
        "https://github.com/hackclub/breadcrumb/releases/download/windows-preview/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
