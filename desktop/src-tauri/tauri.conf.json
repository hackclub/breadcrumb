{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breadcrumb",
  "version": "0.2.0",
  "identifier": "app.rewind.local",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Breadcrumb",
        "width": 1050,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580,
        "visible": true,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/breadcrumb-engine", "binaries/breadcrumb-capture"],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpipewire-0.3-0",
          "libxcb1",
          "libdbus-1-3",
          "libgbm1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
