# Copy to an untracked .env, fill in secrets, then source it with export enabled.
PUBLIC_URL=https://breadcrumb.example.com
LISTEN_ADDR=127.0.0.1:8080
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=breadcrumb-corpus
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LOOPS_API_KEY=
# Published transactional template with a required loginUrl variable.
LOOPS_TRANSACTIONAL_ID=
# Explicit invitations; removing an address also invalidates its sessions/upload tokens.
ALLOWED_EMAILS=you@example.com,friend@example.com
# Optional localhost-only development storage (uses Loops for mail even in local mode).
# PUBLIC_URL=http://localhost:8080
# LOCAL_DATA_DIR=./data

# Optional trusted corpus-review agents. Separate from contributor upload tokens.
# Each review agent can read corpus captures across all contributors.
# REVIEW_AGENT_TOKENS='{"reviewer-1":"replace-with-a-random-secret-at-least-32-characters"}'
# Worker-only settings, not needed by the Go API:
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=deepseek/deepseek-v4.1-flash-1017
